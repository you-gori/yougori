    {
      "id": "web.service",
      "selection": "required",
      "locked": false,
      "applies": true,
      "enabled": true,
      "group": "website_api",
      "name": "A website or API",
      "permissions": [
        "Run containers on this computer."
      ]
    },
    {
      "id": "web.private",
      "selection": "default",
      "locked": false,
      "applies": true,
      "enabled": true,
      "group": "website_api",
      "name": "Keep it to this computer",
      "permissions": []
    },
    {
      "id": "web.quick_link",
      "selection": "optional",
      "locked": false,
      "applies": true,
      "enabled": false,
      "group": "website_api",
      "name": "A quick public link",
      "permissions": [
        "Open a public web address for this setup."
