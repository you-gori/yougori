      "name": "A custom domain",
      "permissions": [
        "Open a public web address for this setup."
      ]
    },
    {
      "id": "run.health_logs",
      "selection": "optional",
      "locked": false,
      "applies": true,
      "enabled": false,
      "group": "automation_recovery",
      "name": "Health and logs",
      "permissions": []
    }
  ],
  "inputs": {
    "access": "quick",
    "app_cpu": "2",
    "app_memory_gb": "2",
    "backup_consistency": "live",
    "backup_keep": "14",
    "backup_missed": "skip",
    "backup_overlap": "queue",
    "backup_retries": "0",
    "backup_schedule": "Mon-Fri 01:30; Sun 04:00",
    "backup_timezone": "Europe/London",
    "data_path": "/var/lib/app",
    "health_path": "/healthz",
    "image": "ghcr.io/example/notes-app:1.2.0"
  },
  "secrets": {},
  "bindings": {},
  "resources": [
    {
      "id": "app-data",
      "kind": "volume",
      "title": "volume",
      "dependsOn": [],
      "retention": {
        "onStop": "keep",
        "onRemove": "keep"
      },
      "placement": "this computer",
      "spec": {
        "backup_consistency": "live",
        "backup_keep": 14,
        "backup_missed": "skip",
        "backup_overlap": "queue",
        "backup_retries": 0,
        "backup_schedule": "Mon-Fri 01:30; Sun 04:00",
        "backup_through": {
          "resource": "backup"
        },
        "backup_timezone": "Europe/London",
        "shared": false
      },
      "outputs": [
        "id",
        "name"
      ]
    },
    {
      "id": "app",
      "kind": "environment",
      "title": "sandbox",
      "dependsOn": [
        "app-data"
      ],
      "retention": {
        "onStop": "keep",
        "onRemove": "keep"
      },
      "placement": "this computer",
      "spec": {
        "automatic_start": false,
        "cpu": 2.0,
        "depends_on": [],
        "environment": {
          "DATA_PATH": "/var/lib/app",
          "PORT": "8080"
        },
        "files": [],
        "gpu": false,
        "health": {
          "path": "/healthz",
          "port": 8080,
          "wait_seconds": 180
        },
        "image": "ghcr.io/example/notes-app:1.2.0",
        "internet": true,
        "memory": 2,
        "pc_access": [],
        "permissions": {
          "edit": false,
          "pc": false
        },
        "ports": [
          8080
        ],
        "restart": "always",
        "secrets": {},
        "storage": 10,
        "type": "container",
        "volumes": [
          {
            "bind": false,
            "read_only": false,
            "source": "app-data",
            "target": "/var/lib/app"
          }
        ]
      },
      "outputs": [
        "name",
        "address"
      ]
    },
    {
      "id": "backup",
      "kind": "environment",
      "title": "sandbox",
      "dependsOn": [
        "app-data"
      ],
      "retention": {
        "onStop": "keep",
        "onRemove": "keep"
      },
      "placement": "this computer",
      "spec": {
        "automatic_start": false,
        "command": [
          "sh",
          "-c",
          "while true; do sleep 3600; done"
        ],
        "cpu": 0.5,
        "depends_on": [],
        "environment": {},
        "files": [],
        "gpu": false,
        "image": "docker.io/library/alpine:3.21",
        "internet": false,
        "memory": 0.5,
        "pc_access": [],
        "permissions": {
          "edit": false,
          "pc": false
        },
        "ports": [],
        "restart": "always",
        "secrets": {},
        "storage": 2,
        "type": "container",
        "volumes": [
          {
            "bind": false,
            "read_only": false,
            "source": "app-data",
            "target": "/var/lib/app"
          }
        ]
      },
      "outputs": [
        "name",
        "address"
      ]
    },
    {
      "id": "web",
      "kind": "service_publication",
      "title": "public address",
      "dependsOn": [
        "app"
      ],
      "retention": {
        "onStop": "keep",
        "onRemove": "keep"
      },
      "placement": "this computer",
      "spec": {
        "access": "quick",
        "health": {
          "expected_status": 200,
          "path": "/healthz"
        },
        "port": 8080,
        "target": {
          "resource": "app"
        }
      },
      "outputs": [
        "url",
        "port"
      ]
    }
  ],
  "order": [
    "app-data",
    "app",
    "backup",
    "web"
  ],
  "steps": [
    {
      "title": "See when the next backup is, and what has been kept",
      "detail": "Shows each backup with its time, how many files it holds and whether the app was stopped while it was copied.",
      "command": "yougori setup show backup-workflow"
    },
    {
      "title": "Practise a restore before you need one",
      "detail": "Puts the newest backup into a new folder inside the backup sandbox and leaves your data alone, so you can check the files are what you expect. Do this once now, not on the day something goes wrong.",
      "command": "yougori terminal {{env.backup}}"
    },
    {
      "title": "Read the app's logs",
      "detail": "If the app does not become healthy after a restore, its output usually says why.",
      "command": "yougori logs {{env.app}}"
    }
  ],
  "outputs": [
    {
      "key": "app",
      "label": "App sandbox",
      "value": "{{outputs.app.name}}",
      "private": false
    },
    {
      "key": "backup_sandbox",
      "label": "Backup sandbox",
      "value": "{{outputs.backup.name}}",
      "private": false
    },
    {
      "key": "address",
      "label": "App address",
      "value": "{{outputs.web.url}}",
      "private": false
    }
  ],
  "retention": {
    "onStop": "keep",
    "onRemove": "keep"
  },
