      "selection": "required",
      "locked": false,
      "applies": true,
      "enabled": true,
      "group": "automation_recovery",
      "name": "Backups",
      "permissions": [
        "Reserve storage on a drive you choose."
      ]
    },
    {
      "id": "run.schedule",
      "selection": "required",
      "locked": false,
      "applies": true,
      "enabled": true,
      "group": "automation_recovery",
      "name": "Schedule",
      "permissions": []
