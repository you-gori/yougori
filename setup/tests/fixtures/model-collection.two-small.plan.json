    {
      "title": "Keep one model ready",
      "detail": "Pin the model you use most so it stays loaded on the GPU; the others load when asked.",
      "command": "yougori model optimize {{outputs.first.id}} --pin"
    },
    {
      "title": "Free the GPU sooner",
      "detail": "Unload a model after it has been idle for a while (10 to 3600 seconds).",
      "command": "yougori model optimize {{outputs.second.id}} --idle 300"
    },
    {
      "title": "See each model's address and key",
      "command": "yougori model access {{outputs.first.id}}"
    }
