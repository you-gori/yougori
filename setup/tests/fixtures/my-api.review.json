      "selection": "required"
    },
    {
      "id": "web.health",
      "locked": false,
      "selection": "optional"
    },
    {
      "id": "web.quick_link",
      "locked": false,
      "selection": "default"
    },
    {
      "id": "web.domain",
      "locked": false,
      "selection": "optional"
    },
    {
      "id": "data.volumes",
      "locked": false,
