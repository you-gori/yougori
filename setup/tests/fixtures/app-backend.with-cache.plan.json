      },
      {
        "id": "db_password",
        "question": "Choose the database password",
        "secret": true,
        "group": "files_data"
      },
      {
        "id": "db_storage_gb",
        "question": "Disk for the database, in whole GB",
        "answer": "20",
        "secret": false,
        "group": "files_data"
      },
      {
        "id": "cache",
        "question": "Add a Redis cache?",
        "answer": "yes",
        "secret": false,
        "group": "files_data"
      },
      {
        "id": "cache_host",
        "question": "Host name your app uses for Redis",
