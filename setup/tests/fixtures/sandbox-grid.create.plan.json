  "order": [
    "company",
    "this_computer",
    "workspaces",
    "first_person"
  ],
  "steps": [
    {
      "title": "Invite people",
      "detail": "Open the People view, add each person with a username and password, then send them the grid invite and their username privately. Each person runs this template with \"Open my workspace\"."
    },
    {
      "title": "Add more computers",
      "detail": "On another computer, run this template with \"Add this computer to a grid\" and paste the invite from the People view. Set what it may give in the Computers view."
    },
    {
      "title": "Optional settings",
      "detail": "In Settings you can add a parking bucket so workspaces move when no computer has room, and cloud fallback computers. Both can cost money with your provider."
    }
  ],
