{
  "formatVersion": 2,
  "instance": "swarm-mining-grid",
  "template": {
    "name": "swarm-mining-grid",
    "version": "0.1.0",
    "formatVersion": 2,
    "profile": "swarm_mining_grid"
  },
  "requires": {
    "yougori": "1.2.0",
    "gpu": "optional",
    "platforms": [
      "windows-x86_64",
      "linux-x86_64"
    ]
  },
  "capabilities": [
    {
      "id": "grid.create",
      "selection": "required",
      "locked": false,
      "applies": true,
      "enabled": true,
      "group": "grid_workers",
      "name": "Create a grid",
      "permissions": [
        "Enroll computers into a grid."
      ]
    },
    {
      "id": "grid.join",
      "selection": "required",
      "locked": false,
      "applies": false,
      "enabled": false,
      "group": "grid_workers",
      "name": "Join a grid",
      "permissions": []
    },
    {
      "id": "research.source",
      "selection": "required",
      "locked": false,
      "applies": true,
      "enabled": true,
      "group": "ai_models",
      "name": "Review source in a sandbox",
      "permissions": [
        "Run authorised research in an isolated realm."
      ]
    },
    {
      "id": "models.local",
      "selection": "required",
      "locked": false,
      "applies": true,
      "enabled": true,
      "group": "ai_models",
      "name": "Local models",
      "permissions": [
        "Serve models from this computer."
      ]
    },
    {
      "id": "data.artifacts",
      "selection": "required",
      "locked": false,
      "applies": true,
      "enabled": true,
      "group": "files_data",
      "name": "Artifacts",
      "permissions": [
        "Reserve storage on a drive you choose."
      ]
    },
    {
      "id": "run.health_logs",
      "selection": "optional",
      "locked": false,
      "applies": true,
      "enabled": false,
      "group": "automation_recovery",
      "name": "Health and logs",
      "permissions": []
    }
  ],
  "inputs": {
    "authorized_scope": "The example-shop source in this folder only. Use the test accounts in TESTING.md; never a real customer's account.",
    "budget_minutes": "60",
    "evidence_gb": "10",
    "instructions": "Look at how sign-in and the checkout handle unexpected input.",
    "mode": "host",
    "model": "hf.co/example/review-model",
    "model_memory_gb": "16",
    "project_title": "Example Shop",
    "report_policy": "review",
    "sandbox_disk_gb": "20",
    "target_kind": "source",
    "visibility": "this_computer",
    "worker_cpu": "4",
    "worker_memory_gb": "8",
    "worker_name": "Review worker"
  },
  "secrets": {},
  "bindings": {
    "source_folder": "/example/folder"
  },
  "resources": [
    {
      "id": "evidence",
      "kind": "artifact_store",
      "title": "artifact store",
      "capability": "data.artifacts",
      "dependsOn": [],
      "retention": {
        "onStop": "keep",
        "onRemove": "ask"
      },
      "placement": "this computer",
      "spec": {
        "access": "setup",
        "max_gb": 10.0
      },
      "outputs": [
        "id",
        "path"
      ]
    },
    {
      "id": "model",
      "kind": "model_service",
      "title": "model service",
      "capability": "models.local",
      "dependsOn": [],
      "retention": {
        "onStop": "keep",
        "onRemove": "ask"
      },
      "placement": "this computer",
      "spec": {
        "api": {
          "keys": 0,
          "protocol": "openai"
        },
        "gpu": "none",
        "memory_gb": 16.0,
        "model": "hf.co/example/review-model",
        "replicas": 1
      },
      "outputs": [
        "id",
        "endpoint",
        "model",
        "first_key"
      ]
    },
    {
      "id": "project",
      "kind": "grid",
      "title": "grid",
      "capability": "grid.create",
      "dependsOn": [],
      "retention": {
        "onStop": "keep",
        "onRemove": "ask"
      },
      "placement": "coordinated by this computer",
      "spec": {
        "access": "lan",
        "coordinator": "this_computer",
        "mode": "create",
        "name": "Example Shop",
        "profile": "swarm_mining_grid",
        "research": {
          "authorization": "The example-shop source in this folder only. Use the test accounts in TESTING.md; never a real customer's account.",
          "instructions": "Look at how sign-in and the checkout handle unexpected input.",
          "target": "source"
        }
      },
      "outputs": [
        "realm_id",
        "join_address",
        "name",
        "page",
        "invitation"
      ]
    },
    {
      "id": "computers",
      "kind": "compute_pool",
      "title": "compute pool",
      "dependsOn": [
        "project"
      ],
      "retention": {
        "onStop": "keep",
        "onRemove": "ask"
      },
      "placement": "this computer",
      "spec": {
        "availability": "always",
        "gpu": "optional",
        "grid": {
          "resource": "project"
        },
        "limits": {
          "cpu": 4.0,
          "disk_gb": 20.0,
          "memory_gb": 8.0
        },
        "local_user_first": true,
        "source": "this_computer"
      },
      "outputs": [
        "id",
        "computers"
      ]
    },
    {
      "id": "sandbox",
      "kind": "environment",
      "title": "sandbox",
      "capability": "research.source",
      "dependsOn": [],
      "retention": {
        "onStop": "keep",
        "onRemove": "ask"
      },
      "placement": "this computer",
      "spec": {
        "automatic_start": false,
        "command": [
          "sleep",
          "infinity"
        ],
        "cpu": 4.0,
        "depends_on": [],
        "environment": {},
        "files": [],
        "gpu": false,
        "image": "ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55",
        "internet": false,
        "memory": 8,
        "pc_access": [],
        "permissions": {
          "edit": false,
          "pc": false
        },
        "ports": [],
        "restart": "",
        "secrets": {},
        "storage": 20,
        "type": "container",
        "volumes": [],
        "working_dir": "/project"
      },
      "outputs": [
        "name",
        "address"
      ]
    },
    {
      "id": "workers",
      "kind": "worker_group",
      "title": "worker group",
      "capability": "research.source",
      "dependsOn": [
        "computers",
        "model",
        "sandbox"
      ],
      "retention": {
        "onStop": "keep",
        "onRemove": "ask"
      },
      "placement": "this computer",
      "spec": {
        "budget": {
          "time_minutes": 60
        },
        "count": 1,
        "environment": {
          "resource": "sandbox"
        },
        "limits": {
          "cpu": 4.0,
          "disk_gb": 20.0,
          "memory_gb": 8.0
        },
        "max": 1,
        "model": {
          "resource": "model"
        },
        "name": "Review worker",
        "pool": {
          "resource": "computers"
        },
        "report_policy": "review",
        "role": "research",
        "source": {
          "binding": "source_folder"
        },
        "source_folder": "/example/folder"
      },
      "outputs": [
        "id",
        "count"
      ]
    }
  ],
  "order": [
    "evidence",
    "model",
    "project",
    "computers",
    "sandbox",
    "workers"
  ],
  "steps": [
    {
      "title": "Read what the agents found",
      "detail": "Findings appear as they are made. Each one says what was tried, what happened, and what it means.",
      "command": "yougori bounty reports"
    },
    {
      "title": "Talk to your worker",
      "detail": "Ask it what it is doing, or steer it towards a part of the project.",
      "command": "yougori bounty chat Review worker"
    }
  ],
  "outputs": [
    {
      "key": "project",
      "label": "Project",
      "value": "Example Shop",
      "private": false
    },
    {
      "key": "worker",
      "label": "Worker",
      "value": "Review worker",
      "private": false
    }
  ],
  "retention": {
    "onStop": "keep",
    "onRemove": "ask"
  },
  "views": [
    "workers",
    "models",
    "findings",
    "attempts",
    "reports",
    "logs"
  ],
  "review": {
    "creates": [
      {
        "id": "evidence",
        "kind": "artifact_store",
        "title": "artifact store",
        "placement": "this computer"
      },
      {
        "id": "model",
        "kind": "model_service",
        "title": "model service",
        "placement": "this computer"
      },
      {
        "id": "project",
        "kind": "grid",
        "title": "grid",
        "placement": "coordinated by this computer"
      },
      {
        "id": "computers",
        "kind": "compute_pool",
        "title": "compute pool",
        "placement": "this computer"
      },
      {
        "id": "sandbox",
        "kind": "environment",
        "title": "sandbox",
        "placement": "this computer"
      },
      {
        "id": "workers",
        "kind": "worker_group",
        "title": "worker group",
        "placement": "this computer"
      }
    ],
    "borrows": [],
    "downloads": [
      {
        "kind": "model",
        "name": "hf.co/example/review-model"
