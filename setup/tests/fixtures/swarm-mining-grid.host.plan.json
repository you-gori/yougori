      {
        "kind": "image",
        "name": "ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55"
      }
    ],
    "permissions": [
      "project starts a Swarm Mining Grid that other computers can join.",
      "workers runs 1 worker(s).",
      "Create a grid: Enroll computers into a grid.",
      "Review source in a sandbox: Run authorised research in an isolated realm.",
      "Local models: Serve models from this computer.",
      "Artifacts: Reserve storage on a drive you choose."
    ],
    "costs": [],
    "warnings": [
      "Uses an NVIDIA GPU when this computer has one."
    ],
    "notes": [],
    "totals": {
      "environments": 1,
      "cpu": 4.0,
      "memoryGb": 8.0,
      "storageGb": 20.0,
      "gpu": "optional"
    },
