          "display_name": "Alex Example",
          "username": "alex.admin"
        },
        "grid": {
          "resource": "company"
        },
        "invitations": 0,
        "mfa": true,
        "people": "team",
        "reset": 0,
        "roles": [
          "owner",
          "admin"
        ],
        "secrets": {
          "admin_password": "hub-access-grid-admin_password"
        },
        "workspaces": "individual"
      },
      "outputs": [
        "id",
        "join_method",
        "page",
        "invitation"
      ]
    }
  ],
  "order": [
    "company",
    "broker",
    "owner"
  ],
  "steps": [
    {
      "title": "Add people and approvers",
      "detail": "In the People view, add each person with a username, a permission (member, approver, auditor or admin) and optional teams. Send them the invite and their username privately; they run this template with \"Sign in to an Access Grid\"."
    },
    {
      "title": "Connect an agent",
      "detail": "On a computer where a person is signed in, add the MCP server shown below to the agent's settings, or call yougori access use from a script. The agent gets the service's answer, never the credential."
    }
  ],
  "outputs": [
    {
      "key": "grid_name",
      "label": "Access Grid",
      "value": "{{outputs.company.name}}",
      "private": false
    },
    {
      "key": "grid_page",
      "label": "Access Grid page",
