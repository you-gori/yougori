        "onStop": "keep",
        "onRemove": "keep"
      },
      "placement": "coordinated by this computer",
      "spec": {
        "access": "lan",
        "address": "192.168.1.20",
        "coordinator": "this_computer",
        "mode": "create",
        "name": "Example Team",
