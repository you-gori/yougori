        "agents": [
          "mcp",
          "cli"
        ],
        "audit_export": false,
        "credentials": [
          {
            "approval": "ask",
            "destinations": [
              "https://api.example.com/v1"
            ],
            "field": "X-Api-Key",
            "kind": "header",
            "methods": [
              "get",
              "post"
            ],
            "name": "example-api",
            "paths": [
              "/v1/reports"
            ],
            "value": "credential_value"
          }
        ],
        "grid": {
          "resource": "company"
        },
        "secrets": {
          "credential_value": "hub-access-grid-credential_value"
        }
      },
      "outputs": [
        "id",
        "endpoint"
      ]
    },
    {
      "id": "owner",
      "kind": "access_binding",
      "title": "people and access",
      "dependsOn": [
