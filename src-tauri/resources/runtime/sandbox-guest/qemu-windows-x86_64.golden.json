{
  "format": 1,
  "backend_kind": "qemu",
  "backend_version": "11.1.0",
  "os": "windows",
  "architecture": "x86_64",
  "profile": "hardened_whpx",
  "arguments": [
    "-name",
    "{instance}",
    "-machine",
    "microvm,acpi=on,pcie=off,usb=off,graphics=off,isa-serial=off,pic=off,pit=off,rtc=off",
    "-accel",
    "whpx,kernel-irqchip=off",
    "-cpu",
    "max,vmx=off,svm=off",
    "-smp",
    "cpus={vcpu_count},maxcpus={vcpu_count},sockets=1,cores={vcpu_count},threads=1",
    "-m",
    "{memory}",
    "-nodefaults",
    "-no-user-config",
    "-display",
    "none",
    "-L",
    "{firmware_directory}",
    "-kernel",
    "{kernel}",
    "-initrd",
    "{initrd}",
    "-append",
    "{kernel_arguments}",
    "-blockdev",
    "driver=file,node-name=root-file,filename={root_image},read-only=on",
    "-blockdev",
    "driver=raw,node-name=root,file=root-file,read-only=on",
    "-device",
    "virtio-blk-device,id=root-disk,drive=root",
    "-device",
    "virtio-rng-device,id=rng",
    "-chardev",
    "socket,id=link,path={link_socket},server=on,wait=off",
    "-device",
    "virtio-serial-device,id=link-bus,max_ports=2",
    "-device",
    "virtserialport,id=link-port,bus=link-bus.0,chardev=link,name=org.yougori.link",
    "-fw_cfg",
    "name=opt/yougori/link-secret,file={link_secret}",
    "-fw_cfg",
    "name=opt/yougori/egress-endpoints,file={egress_endpoints}",
    "-fw_cfg",
    "name=opt/yougori/workload,file={workload}",
    "-chardev",
    "socket,id=qmp,path={qmp_socket},server=on,wait=off",
    "-mon",
    "chardev=qmp,mode=control",
    "-action",
    "reboot=shutdown,panic=exit-failure"
  ],
  "digest": "a7741b36023b60f512ec6a2b58edee71615145ab90fc0325dccd434558477502"
}
