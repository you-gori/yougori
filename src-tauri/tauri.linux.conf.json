{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "deb"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../COPYING": "COPYING",
      "../COMMERCIAL_LICENSE.txt": "COMMERCIAL_LICENSE.txt",
      "../NOTICE": "NOTICE",
      "../node_modules/@novnc/novnc/": "third-party-sources/novnc/",
      "resources/runtime/appliance/": "runtime/appliance/",
      "resources/cli/yougori-cli": "cli/yougori-cli",
      "resources/cli/opendock-cli": "cli/opendock-cli",
      "resources/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "resources/APPLICATION_LICENSES.txt": "APPLICATION_LICENSES.txt",
      "resources/RUNTIME_LICENSES.txt": "RUNTIME_LICENSES.txt",
      "resources/WORKSPACE_LICENSES.txt": "WORKSPACE_LICENSES.txt",
      "resources/cli/yougori": "cli/yougori",
      "src/model_runner/adapters/clef/LICENSE": "licenses/clef/LICENSE",
      "src/model_runner/adapters/clef/source.json": "licenses/clef/source.json",
      "src/model_runner/adapters/clef/joint_schema_model.py": "licenses/clef/joint_schema_model.py"
    },
    "linux": {
      "deb": {
        "depends": [
          "qemu-system-x86 (>= 6.2)",
          "qemu-utils (>= 6.2)",
          "ovmf",
          "openssh-client",
          "ca-certificates",
          "libsecret-1-0"
        ],
        "recommends": [
          "gnome-keyring"
        ],
        "files": {
          "/usr/bin/yougori-cli": "resources/cli/yougori-cli",
          "/usr/bin/yougori": "resources/cli/yougori"
        }
      }
    }
  },
  "mainBinaryName": "yougori-desktop"
}
