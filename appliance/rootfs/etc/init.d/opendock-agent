#!/sbin/openrc-run

name="Yougori appliance agent"
description="Private control plane for the bundled Yougori OCI runtime"
command="/usr/local/sbin/opendock-agent"
command_background="yes"
pidfile="/run/opendock-agent.pid"
output_log="/var/log/opendock-agent.log"
error_log="/var/log/opendock-agent.log"

start_pre() {
  umask 077
  if [ -f "$output_log" ] && [ "$(wc -c < "$output_log")" -gt 1048576 ]; then
    tail -c 262144 "$output_log" > "$output_log.trimmed"
    mv -f "$output_log.trimmed" "$output_log"
  fi
}

depend() {
  if ! grep -qw 'opendock.mode=microvm' /proc/cmdline 2>/dev/null; then
    need containerd
  fi
  after networking
}
