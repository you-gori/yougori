diff --git a/hw/tpm/tpm_ppi.c b/hw/tpm/tpm_ppi.c
index f0c3429..e040bf4 100644
--- a/hw/tpm/tpm_ppi.c
+++ b/hw/tpm/tpm_ppi.c
@@ -48,11 +48,15 @@ void tpm_ppi_init(TPMPPI *tpmppi, MemoryRegion *m,
                   hwaddr addr, Object *obj)
 {
     size_t host_page_size = qemu_real_host_page_size();
+    /* Yougori: WHPX requires complete host pages for RAM device mappings.
+     * Reserve/zero the already-allocated padding too; do not expose heap bytes
+     * to the guest. The ACPI PPI operation region remains its specified size. */
+    size_t mapping_size = ROUND_UP(TPM_PPI_ADDR_SIZE, host_page_size);
 
-    tpmppi->buf = qemu_memalign(host_page_size,
-                                ROUND_UP(TPM_PPI_ADDR_SIZE, host_page_size));
+    tpmppi->buf = qemu_memalign(host_page_size, mapping_size);
+    memset(tpmppi->buf, 0, mapping_size);
     memory_region_init_ram_device_ptr(&tpmppi->ram, obj, "tpm-ppi",
-                                      TPM_PPI_ADDR_SIZE, tpmppi->buf);
+                                      mapping_size, tpmppi->buf);
     vmstate_register_ram(&tpmppi->ram, DEVICE(obj));
 
     memory_region_add_subregion(m, addr, &tpmppi->ram);
