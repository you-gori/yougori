# The Yougori harness's Sandbox VM images, built with Buildah by
# scripts/build-vm-images.py yougori (nothing here runs when a VM starts).
#
# One base image holds the runtime and Yougori's own harness binary, in three variants for the
# engines that need system services: base, postgres (PostgreSQL 17 with pgvector: Plandex and
# PentAGI) and chromium (Chromium's system libraries and fonts: Shannon). Chromium's own program
# folder (381 MiB) would take the chromium variant over the 256 MiB image bound, so it travels in
# Shannon's pack as it did in Shannon's own image, built from the same installation as the variant.
#
# A pack is one harness's engine: the tool archive (tool/ and source/) today's installer builds
# on the same pinned OS, with what its build needs (Go for Plandex and PentAGI). The launcher
# delivers it into the VM through the private control connection (vm_package).
ARG VARIANT=os
ARG PACK_FROM=os
FROM docker.io/library/node:22-bookworm-slim@sha256:5ec23b7c622b00547753bc6ffd78085dd868a68aeb41c8e0a1418f033e13d96d AS node
# The OS of every image and pack: the per-harness images' (Containerfile), instruction for
# instruction, so a pack built for a per-harness image matches the base exactly.
FROM docker.io/library/python:3.12-slim-trixie@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54 AS os
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && useradd --create-home --uid 1000 node \
    && apt-get update && apt-get install -y --no-install-recommends git curl ca-certificates libdbus-1-3 ripgrep fd-find \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man

FROM os AS os-postgres
# Debian's package also creates a cluster; each harness creates its own database in the VM.
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-17 postgresql-17-pgvector \
    && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man /usr/share/i18n /var/lib/postgresql \
       /usr/lib/postgresql/17/lib/bitcode

FROM os AS os-chromium
RUN apt-get update && apt-get install -y --no-install-recommends chromium \
    && mkdir -p /opt/solver/tool && mv /usr/lib/chromium /opt/solver/tool/chromium \
    && ln -s /opt/solver/tool/chromium /usr/lib/chromium \
    && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man

# A harness's pack. Shannon's builds on os-chromium (PACK_FROM), so its Chromium folder is the
# chromium variant's own; every other pack builds on os.
FROM ${PACK_FROM} AS pack
ARG HARNESS
RUN if [ "$HARNESS" = plandex ]; then apt-get update && apt-get install -y --no-install-recommends golang-go build-essential && rm -rf /var/lib/apt/lists/*; fi
RUN if [ "$HARNESS" = pentagi ]; then apt-get update && apt-get install -y --no-install-recommends golang-go && rm -rf /var/lib/apt/lists/*; fi
WORKDIR /opt/solver
COPY installer.py install_shannon.py install_pentagi.py pentagi_vm.go pentagi_vm_test.go ./
# PentAGI's adapter tests (install_pentagi.py) work in /work as the VM's user, as in the per-harness
# Containerfile. The pack takes only tool/ and source/; the runtime stage makes its own /work.
RUN mkdir -p /work /home/node/.config && chown -R node:node /work /home/node /opt/solver
ARG TOOL_SPEC
ENV TOOL_SPEC=$TOOL_SPEC
ENV HOME=/home/node
USER 1000:1000
# Go keeps its module cache read-only; the caches never reach the pack.
RUN python3 installer.py "$HARNESS" \
    && tar -czf tool.tar.gz tool $(test ! -d source || printf source) \
    && { test ! -d /home/node/go || chmod -R u+w /home/node/go; } \
    && rm -rf tool source /home/node/.cache /home/node/go /home/node/.npm /home/node/.local

# The base image a Yougori harness VM starts from (VARIANT: os, os-postgres or os-chromium). It
# pins no tool package: the launcher tells the VM which harness's pack to expect, or that none is
# needed (vm_package), and the VM checks the pack against that hash.
FROM ${VARIANT} AS runtime
ARG VARIANT
WORKDIR /opt/solver
COPY relay.py transport.py blue.py profiles.py runtime.py vm_guest.py vm_package.py vm_tunnel.py practice_app.py \
     hexstrike_cli.py plandex_cli.py strix_cli.py shannon_cli.py pentagi_cli.py ./
COPY bridges/*.py ./bridges/
COPY --from=harness yougori-harness /usr/local/bin/yougori-harness
# The runtime files stay root's and read-only; the VM's user writes only the pack into
# /opt/solver. Chromium's folder comes with Shannon's pack; PentAGI's tools work in /work, its copy
# of the workspace. The runtime has no package manager; build-only files and privileged OS helpers
# go before Yougori imports this unprivileged workload (and keep it within 8,000 entries).
RUN printf yougori > harness-name \
    && chmod 0644 harness-name *.py bridges/*.py && chmod 0755 bridges /usr/local/bin/yougori-harness \
    && rm -rf /opt/solver/tool \
    && mkdir -p /workspace /home/node/.config \
    && if [ "$VARIANT" = os-postgres ]; then ln -s /home/node/pentagi-work /work; else mkdir -p /work && chown node:node /work; fi \
    && if [ "$VARIANT" = os-chromium ]; then rm -rf /usr/share/icons /usr/share/mime /usr/share/perl /usr/share/perl5; fi \
    && chown node:node /opt/solver /workspace /home/node /home/node/.config \
    && find / -xdev -perm /6000 -exec chmod a-s {} + \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx \
       /usr/local/lib/python3.12/ensurepip /usr/local/lib/python3.12/idlelib \
       /usr/local/lib/python3.12/tkinter /usr/local/lib/python3.12/site-packages/pip \
       /usr/local/include/python3.12 /home/node/.npm /home/node/.cache /var/lib/dpkg
ENV HOME=/home/node
USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/python3", "/opt/solver/vm_guest.py"]
